    "committed_on": "2026-10-20, on the maintainer's decision to commit the transcriptions with attribution",
    "attribution": "Transcription by Olaf Ostwald; header-table compilation by Ostwald (2021, 2023); passed on by Frode Weierud, CryptoCellar."
  },
  "transcription": {
    "text": "Every cipher group from the note, first group included, whitespace removed; '-' (illegible) replaced by '?'.",
    "checks": "Each text's length and IC (uncertain letters excluded) equal the values the note prints for it. The note's FKQLZ, XFEDT and SZAEJ, which are not in this file, agree letter for letter with corpus.json once its first group is prepended.",
    "first_group": "For these hand-cipher texts there is no discriminant convention; first_group is kept as part of text.",
    "j_absent": "None of the ten contains J; the note's J column marks all ten 'ohne' (without)."
  },
