{
  "schema": "enigma-attack.artifact-claims/v1",
  "purpose": "Declare which paths of each generated artifact constitute the experiment's claim. The drift check compares only these paths, so a field that is not listed is not checked. The list is an allowlist rather than a denylist of volatile fields: failing to list a field leaves it unchecked and visible, whereas omitting a field from a denylist would silently stop checking a conclusion.",
  "path_syntax": "Dot-separated keys. '[]' matches every element of a list. A trailing '*' matches every key of the object at that point.",
  "artifacts": {
    "artifacts/phase1-smoke-certificate.json": {
      "runner": [
        "phase1.py",
        "search",
        "--rings",
        "AAA"
      ],
      "claim_paths": [
        "schema",
        "implementation.files_sha256.corpus",
        "simulator_validation[].name",
        "simulator_validation[].expected",
        "simulator_validation[].actual",
        "simulator_validation[].passed",
